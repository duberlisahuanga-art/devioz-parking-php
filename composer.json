{
  "name": "devioz/parking",
  "description": "Gestión de estacionamiento mensual DEVIOZ",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "phpmailer/phpmailer": "^7.0"
  },
  "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1", "squizlabs/php_codesniffer": "^3.13"},
  "autoload": {"classmap": ["backend/controllers/", "backend/models/", "backend/services/", "backend/support.php"], "exclude-from-classmap": ["**/*.backup.php"]},
  "scripts": {"quality": "@php tools/quality.php", "test": "phpunit", "analyse": "phpstan analyse --memory-limit=512M", "style": "phpcs", "audit-deps": "composer audit"},
  "config": {"sort-packages": true, "allow-plugins": {}, "platform": {"php": "8.2.12"}}
}
