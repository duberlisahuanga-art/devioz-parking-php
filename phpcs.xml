<?xml version="1.0"?>
<ruleset name="DEVIOZ código endurecido">
  <description>PSR-12 para la lógica nueva y los controladores corregidos; plantillas heredadas se revisan por separado.</description>
  <rule ref="PSR12">
    <!-- Compatibilidad explícita con clases globales y excepciones del bootstrap heredado. -->
    <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
    <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
  </rule>
  <file>backend/config/app.php</file>
  <file>backend/support.php</file>
  <file>backend/controllers/PaymentController.php</file>
  <file>backend/controllers/ReservationController.php</file>
  <file>backend/services/RateLimiter.php</file>
  <file>backend/services/VoucherService.php</file>
  <arg name="extensions" value="php"/>
  <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
